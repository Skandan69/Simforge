# SimForge dedicated non-production Supabase staging environment.
# Copy to .env.staging locally only. Never commit the copied file.
#
# Required safety check before any migration:
# every Supabase host/project reference below must be zyrxivxvywruyoogrmki.

# Prisma migrations: use the direct database connection when available.
# If your network cannot reach the direct host, use Supabase's session pooler
# for migrations, not the transaction pooler.
DIRECT_URL="postgresql://postgres:<STAGING_DATABASE_PASSWORD>@db.zyrxivxvywruyoogrmki.supabase.co:5432/postgres?sslmode=require"

# API runtime: use the Supabase transaction pooler.
DATABASE_URL="postgresql://postgres.zyrxivxvywruyoogrmki:<STAGING_DATABASE_PASSWORD>@<STAGING_POOLER_HOST>:6543/postgres?sslmode=require&pgbouncer=true"

SUPABASE_URL="https://zyrxivxvywruyoogrmki.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<STAGING_SUPABASE_PUBLISHABLE_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<STAGING_SUPABASE_SERVICE_ROLE_KEY>"

PORT=4000
NODE_ENV=development
WEB_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

AI_PROVIDER="openai"
OPENAI_API_KEY="<SERVER_ONLY_OPENAI_KEY_FOR_STAGING>"
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
AI_HISTORY_LIMIT=16
AI_SESSION_MESSAGE_LIMIT=80
AI_KNOWLEDGE_SECTION_LIMIT=8

EMBEDDING_PROVIDER="openai"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=2

OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
OPENAI_SPEECH_MODEL="gpt-4o-mini-tts"
SOPHIA_TTS_VOICE="coral"
OPENAI_TTS_VOICE=""
SOPHIA_TTS_INSTRUCTIONS="Speak as a warm, confident female professional in her late twenties. Use clear international English, friendly energy, natural pauses, varied but calm intonation, and a measured conversational pace. Sound emotionally intelligent and fully in character, never robotic or theatrical."
VOICE_TIMEOUT_MS=30000
VOICE_MAX_AUDIO_BYTES=10000000
VOICE_MIN_AUDIO_BYTES=1000
VOICE_MIN_DURATION_MS=1000
