generator client {
  provider = "prisma-client"
  output   = "../../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Owner
  Admin
  Trainer
  Manager
  Learner
}

enum KnowledgeBaseStatus {
  Active
  Archived
}

enum DocumentFileType {
  PDF
  DOCX
  PPTX
  XLSX
}

enum DocumentStatus {
  Ready
  Archived
  Failed
}

enum ProcessingStatus {
  Uploaded
  Queued
  Processing
  Completed
  Failed
  Cancelled
}

enum DocumentVersionRetrievalStatus {
  PROCESSING
  ACTIVE
  SUPERSEDED
  FAILED
  ARCHIVED
}

enum KnowledgeChunkStatus {
  PROCESSING
  ACTIVE
  SUPERSEDED
  FAILED
  ARCHIVED
}

enum KnowledgeSourceType {
  PDF
  DOCX
  PPTX
  XLSX
  Website
  Video
  Audio
  Image
  SharePoint
  Confluence
  API
}

enum ProcessingLogLevel {
  Info
  Warning
  Error
}

enum KnowledgeSectionType {
  Policy
  Procedure
  ProductInformation
  FAQ
  BestPractice
  Compliance
  GeneralReference
  Unknown
}

enum KnowledgeImportance {
  Critical
  Important
  Reference
  Optional
}

enum OrganizationBlueprintStatus {
  DRAFT
  APPROVED
}

enum CapabilityTrend {
  NEW
  IMPROVING
  STABLE
  DECLINING
}

enum CapabilityConfidence {
  LOW
  MEDIUM
  HIGH
}

enum LearningFactoryAssetType {
  SIMULATION
  QUESTION_BANK
  LEARNING_OBJECTIVE
  COACHING_FOCUS
}

enum LearningFactoryDraftStatus {
  DRAFT
  APPROVED
  REJECTED
  PUBLISHED
}

enum CoachingGeneratedBy {
  DETERMINISTIC
  AI
}

enum SimulationDifficulty {
  Beginner
  Intermediate
  Advanced
  Expert
}

enum SimulationStatus {
  Draft
  Active
  Archived
}

enum SimulationSessionStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum PracticeAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssessmentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssessmentAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum DevelopmentPathStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DevelopmentPathStepType {
  PRACTICE
  ASSESSMENT
}

enum DevelopmentPathAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SimulationMessageRole {
  learner
  ai
  system
}

model Profile {
  id                    String            @id @db.Uuid
  email                 String            @unique
  fullName              String?
  avatarUrl             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  memberships           Membership[]
  createdOrganizations  Organization[]    @relation("OrganizationCreator")
  activities            Activity[]
  knowledgeBasesCreated KnowledgeBase[]   @relation("KnowledgeBaseCreator")
  documentsUploaded     Document[]        @relation("DocumentUploader")
  versionsUploaded      DocumentVersion[] @relation("DocumentVersionUploader")
  simulationsCreated    Simulation[]       @relation("SimulationCreator")
  personasCreated       SimulationPersona[] @relation("PersonaCreator")
  criteriaCreated       SimulationEvaluationCriterion[] @relation("CriterionCreator")
  simulationSessions    SimulationSession[] @relation("SessionLearner")
  practiceAssignments   PracticeAssignment[] @relation("PracticeAssignmentLearner")
  assignedPractice      PracticeAssignment[] @relation("PracticeAssignmentAssigner")
  assessmentsCreated    Assessment[] @relation("AssessmentCreator")
  assessmentAssignments AssessmentAssignment[] @relation("AssessmentAssignmentLearner")
  assignedAssessments   AssessmentAssignment[] @relation("AssessmentAssignmentAssigner")
  assessmentAttempts    AssessmentAttempt[] @relation("AssessmentAttemptLearner")
  developmentPathsCreated DevelopmentPath[] @relation("DevelopmentPathCreator")
  developmentPathAssignments DevelopmentPathAssignment[] @relation("DevelopmentPathAssignmentLearner")
  assignedDevelopmentPaths DevelopmentPathAssignment[] @relation("DevelopmentPathAssignmentAssigner")
  capabilityProfiles    LearnerCapabilityProfile[] @relation("CapabilityProfileLearner")
  coachingInsights      SimulationCoachingInsight[] @relation("CoachingInsightLearner")
}

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  industry       String
  companySize    String
  country        String
  timezone       String
  logoUrl        String?
  createdBy      String          @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  creator        Profile         @relation("OrganizationCreator", fields: [createdBy], references: [id])
  memberships    Membership[]
  activities     Activity[]
  knowledgeBases KnowledgeBase[]
  knowledgeSources KnowledgeSource[]
  simulations     Simulation[]
  simulationPersonas SimulationPersona[]
  evaluationCriteria SimulationEvaluationCriterion[]
  simulationSessions SimulationSession[]
  practiceAssignments PracticeAssignment[]
  assessments          Assessment[]
  assessmentAssignments AssessmentAssignment[]
  assessmentAttempts   AssessmentAttempt[]
  developmentPaths     DevelopmentPath[]
  developmentPathAssignments DevelopmentPathAssignment[]
  developmentPathStepProgress DevelopmentPathStepProgress[]
  capabilityProfiles LearnerCapabilityProfile[]
  learningFactoryDrafts LearningFactoryDraft[]
  coachingInsights SimulationCoachingInsight[]
  blueprint          OrganizationBlueprint?

  @@index([createdBy])
}

model OrganizationBlueprint {
  id                     String                      @id @default(uuid()) @db.Uuid
  organizationId         String                      @unique @db.Uuid
  industry               String
  teamSizeRange          String
  primaryTrainingGoals   Json
  priorityCapabilities   Json
  criticalDocumentsNotes String                      @default("") @db.Text
  successDefinition      String                      @default("") @db.Text
  costlyMistakes         String                      @default("") @db.Text
  nonNegotiables         String                      @default("") @db.Text
  status                 OrganizationBlueprintStatus @default(DRAFT)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  organization           Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model KnowledgeBase {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  description    String
  department     String
  status         KnowledgeBaseStatus @default(Active)
  createdBy      String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        Profile             @relation("KnowledgeBaseCreator", fields: [createdBy], references: [id])
  documents      Document[]
  simulationLinks SimulationKnowledgeBase[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, department])
}

model Simulation {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  title             String
  description       String
  industry          String
  department        String
  jobRole           String
  category          String
  difficulty        SimulationDifficulty
  status            SimulationStatus     @default(Draft)
  estimatedMinutes  Int
  personaId         String?              @db.Uuid
  scenarioSetup     String               @db.Text
  successCriteria   String               @db.Text
  createdBy         String               @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator           Profile              @relation("SimulationCreator", fields: [createdBy], references: [id])
  persona           SimulationPersona?   @relation(fields: [personaId], references: [id], onDelete: SetNull)
  objectives        SimulationObjective[]
  evaluationCriteria SimulationCriterionLink[]
  knowledgeBases    SimulationKnowledgeBase[]
  versions          SimulationVersion[]
  sessions          SimulationSession[]
  practiceAssignments PracticeAssignment[]
  assessments       Assessment[]
  developmentPathSteps DevelopmentPathStep[]
  publishedLearningFactoryDraft LearningFactoryDraft? @relation("LearningFactoryPublishedSimulation")

  @@index([organizationId, status])
  @@index([organizationId, department])
  @@index([organizationId, difficulty])
  @@index([personaId])
}

model SimulationPersona {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  name               String
  role               String
  personality        String
  tone               String
  difficultyBehavior String       @db.Text
  backgroundContext  String       @db.Text
  createdBy          String       @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator            Profile      @relation("PersonaCreator", fields: [createdBy], references: [id])
  simulations        Simulation[]

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
}

model SimulationObjective {
  id           String     @id @default(uuid()) @db.Uuid
  simulationId String     @db.Uuid
  title        String
  sortOrder    Int
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, sortOrder])
}

model SimulationEvaluationCriterion {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String
  isDefault      Boolean      @default(false)
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        Profile      @relation("CriterionCreator", fields: [createdBy], references: [id])
  simulations    SimulationCriterionLink[]

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt])
}

model SimulationCriterionLink {
  simulationId String                        @db.Uuid
  criterionId  String                        @db.Uuid
  simulation   Simulation                    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  criterion    SimulationEvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@id([simulationId, criterionId])
  @@index([criterionId])
}

model SimulationKnowledgeBase {
  simulationId  String        @db.Uuid
  knowledgeBaseId String      @db.Uuid
  simulation    Simulation    @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@id([simulationId, knowledgeBaseId])
  @@index([knowledgeBaseId])
}

model SimulationVersion {
  id           String     @id @default(uuid()) @db.Uuid
  simulationId String     @db.Uuid
  version      Int
  snapshot     Json
  createdAt    DateTime   @default(now())
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, version])
}

model SimulationSession {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  simulationId   String                  @db.Uuid
  learnerId      String                  @db.Uuid
  status         SimulationSessionStatus @default(IN_PROGRESS)
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  overallScore   Float?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  simulation     Simulation              @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  learner        Profile                 @relation("SessionLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  messages       SimulationMessage[]
  evaluation     SimulationEvaluation?
  capabilityScores CapabilityScore[]
  capabilityHistory CapabilityAssessmentHistory[]
  coachingInsight SimulationCoachingInsight?
  practiceAssignment PracticeAssignment?
  assessmentAttempt AssessmentAttempt?

  @@index([organizationId, createdAt])
  @@index([simulationId, status])
  @@index([learnerId, createdAt])
}

model PracticeAssignment {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  learnerId      String                   @db.Uuid
  simulationId   String                   @db.Uuid
  assignedBy     String                   @db.Uuid
  sessionId      String?                  @unique @db.Uuid
  status         PracticeAssignmentStatus @default(ASSIGNED)
  reason         String                   @default("") @db.Text
  focusCapability String?
  assignedAt     DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  learner        Profile                  @relation("PracticeAssignmentLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  assigner       Profile                  @relation("PracticeAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: Cascade)
  simulation     Simulation               @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  session        SimulationSession?       @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  developmentPathStepProgress DevelopmentPathStepProgress?

  @@index([organizationId, status, assignedAt])
  @@index([organizationId, learnerId, status])
  @@index([organizationId, simulationId])
  @@index([assignedBy])
}

model Assessment {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  simulationId     String           @db.Uuid
  title            String
  description      String           @default("") @db.Text
  capabilities     String[]
  passingScore     Float            @default(70)
  status           AssessmentStatus @default(DRAFT)
  createdBy        String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  simulation       Simulation       @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  creator          Profile          @relation("AssessmentCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  assignments      AssessmentAssignment[]
  attempts         AssessmentAttempt[]
  developmentPathSteps DevelopmentPathStep[]

  @@index([organizationId, status, updatedAt])
  @@index([simulationId])
  @@index([createdBy])
}

model AssessmentAssignment {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  assessmentId   String                     @db.Uuid
  learnerId      String                     @db.Uuid
  assignedBy     String                     @db.Uuid
  attemptId      String?                    @unique @db.Uuid
  status         AssessmentAssignmentStatus @default(ASSIGNED)
  reason         String                     @default("") @db.Text
  assignedAt     DateTime                   @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment     Assessment                 @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner        Profile                    @relation("AssessmentAssignmentLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  assigner       Profile                    @relation("AssessmentAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: Cascade)
  attempt        AssessmentAttempt?         @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  developmentPathStepProgress DevelopmentPathStepProgress?

  @@index([organizationId, status, assignedAt])
  @@index([organizationId, learnerId, status])
  @@index([organizationId, assessmentId])
  @@index([assignedBy])
}

model AssessmentAttempt {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @db.Uuid
  assessmentId        String                  @db.Uuid
  learnerId           String                  @db.Uuid
  simulationSessionId String                  @unique @db.Uuid
  status              AssessmentAttemptStatus @default(IN_PROGRESS)
  overallScore        Float?
  passed              Boolean?
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessment          Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner             Profile                 @relation("AssessmentAttemptLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  simulationSession   SimulationSession       @relation(fields: [simulationSessionId], references: [id], onDelete: Cascade)
  assignment          AssessmentAssignment?

  @@index([organizationId, learnerId, status])
  @@index([organizationId, assessmentId])
}

model DevelopmentPath {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  title          String
  description    String                @default("") @db.Text
  targetRole     String                @default("")
  department     String                @default("")
  capabilities   String[]
  status         DevelopmentPathStatus @default(DRAFT)
  createdBy      String                @db.Uuid
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        Profile               @relation("DevelopmentPathCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  steps          DevelopmentPathStep[]
  assignments    DevelopmentPathAssignment[]

  @@index([organizationId, status, updatedAt])
  @@index([createdBy])
}

model DevelopmentPathStep {
  id                String                  @id @default(uuid()) @db.Uuid
  developmentPathId String                  @db.Uuid
  type              DevelopmentPathStepType
  sortOrder         Int
  title             String
  required          Boolean                 @default(true)
  simulationId      String?                 @db.Uuid
  assessmentId      String?                 @db.Uuid
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  developmentPath   DevelopmentPath         @relation(fields: [developmentPathId], references: [id], onDelete: Cascade)
  simulation        Simulation?             @relation(fields: [simulationId], references: [id], onDelete: Restrict)
  assessment        Assessment?             @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  progress          DevelopmentPathStepProgress[]

  @@unique([developmentPathId, sortOrder])
  @@index([simulationId])
  @@index([assessmentId])
}

model DevelopmentPathAssignment {
  id                String                          @id @default(uuid()) @db.Uuid
  organizationId    String                          @db.Uuid
  developmentPathId String                          @db.Uuid
  learnerId         String                          @db.Uuid
  assignedBy        String                          @db.Uuid
  status            DevelopmentPathAssignmentStatus @default(ASSIGNED)
  reason            String                          @default("") @db.Text
  assignedAt        DateTime                        @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  organization      Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  developmentPath   DevelopmentPath                 @relation(fields: [developmentPathId], references: [id], onDelete: Cascade)
  learner           Profile                         @relation("DevelopmentPathAssignmentLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  assigner          Profile                         @relation("DevelopmentPathAssignmentAssigner", fields: [assignedBy], references: [id], onDelete: Cascade)
  stepProgress      DevelopmentPathStepProgress[]

  @@unique([organizationId, developmentPathId, learnerId, status])
  @@index([organizationId, status, assignedAt])
  @@index([organizationId, learnerId, status])
  @@index([assignedBy])
}

model DevelopmentPathStepProgress {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @db.Uuid
  pathAssignmentId       String                    @db.Uuid
  stepId                 String                    @db.Uuid
  practiceAssignmentId   String?                   @unique @db.Uuid
  assessmentAssignmentId String?                   @unique @db.Uuid
  startedAt              DateTime                  @default(now())
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  organization           Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pathAssignment         DevelopmentPathAssignment @relation(fields: [pathAssignmentId], references: [id], onDelete: Cascade)
  step                   DevelopmentPathStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  practiceAssignment     PracticeAssignment?       @relation(fields: [practiceAssignmentId], references: [id], onDelete: SetNull)
  assessmentAssignment   AssessmentAssignment?     @relation(fields: [assessmentAssignmentId], references: [id], onDelete: SetNull)

  @@unique([pathAssignmentId, stepId])
  @@index([organizationId, pathAssignmentId])
  @@index([stepId])
}

model SimulationCoachingInsight {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @db.Uuid
  sessionId            String              @unique @db.Uuid
  learnerId            String              @db.Uuid
  summary              String              @db.Text
  strengths            Json
  improvementAreas     Json
  capabilityChanges    Json
  knowledgeGaps        Json
  nextBestAction       Json
  estimatedImprovement Json
  generatedBy          CoachingGeneratedBy @default(DETERMINISTIC)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session              SimulationSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner              Profile             @relation("CoachingInsightLearner", fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([organizationId, learnerId, createdAt])
}

model LearnerCapabilityProfile {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @db.Uuid
  learnerId            String               @db.Uuid
  overallScore         Float
  previousOverallScore Float?
  trend                CapabilityTrend      @default(NEW)
  confidence           CapabilityConfidence @default(LOW)
  simulationCount      Int                  @default(0)
  lastAssessedAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  learner              Profile              @relation("CapabilityProfileLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  capabilities         LearnerCapability[]
  history              CapabilityAssessmentHistory[]

  @@unique([organizationId, learnerId])
  @@index([learnerId, updatedAt])
}

model LearnerCapability {
  id              String                   @id @default(uuid()) @db.Uuid
  profileId       String                   @db.Uuid
  capabilityName  String
  currentScore    Float
  previousScore   Float?
  change          Float                    @default(0)
  lastAssessedAt  DateTime
  assessmentCount Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  profile         LearnerCapabilityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, capabilityName])
  @@index([profileId, currentScore])
}

model CapabilityAssessmentHistory {
  id             String                   @id @default(uuid()) @db.Uuid
  profileId      String                   @db.Uuid
  sessionId      String                   @db.Uuid
  capabilityName String
  currentScore   Float
  previousScore  Float?
  change         Float                    @default(0)
  assessedAt     DateTime                 @default(now())
  profile        LearnerCapabilityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  session        SimulationSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, capabilityName])
  @@index([profileId, assessedAt])
}

model SimulationMessage {
  id        String                @id @default(uuid()) @db.Uuid
  sessionId String                @db.Uuid
  role      SimulationMessageRole
  content   String                @db.Text
  createdAt DateTime              @default(now())
  session   SimulationSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SimulationEvaluation {
  id                      String            @id @default(uuid()) @db.Uuid
  sessionId               String            @unique @db.Uuid
  overallScore            Float
  strengths               Json
  improvementAreas        Json
  evidence                 Json
  recommendedNextPractice String            @db.Text
  createdAt               DateTime          @default(now())
  session                 SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CapabilityScore {
  id               String            @id @default(uuid()) @db.Uuid
  sessionId        String            @db.Uuid
  capabilityName   String
  score            Float
  evidence         String            @db.Text
  recommendation   String            @db.Text
  createdAt        DateTime          @default(now())
  session          SimulationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, capabilityName])
  @@index([sessionId])
}

model Document {
  id              String            @id @default(uuid()) @db.Uuid
  knowledgeBaseId String            @db.Uuid
  fileName        String
  fileType        DocumentFileType
  mimeType        String
  sizeBytes       BigInt
  storagePath     String            @unique
  uploadedBy      String            @db.Uuid
  uploadedAt      DateTime          @default(now())
  currentVersion  Int               @default(1)
  retrievalVersion Int              @default(1)
  status          DocumentStatus    @default(Ready)
  notes           String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  knowledgeBase   KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  uploader        Profile           @relation("DocumentUploader", fields: [uploadedBy], references: [id])
  versions        DocumentVersion[]
  knowledgeSource KnowledgeSource?
  knowledgeChunks KnowledgeChunk[]
  learningFactoryDrafts LearningFactoryDraft[]

  @@index([knowledgeBaseId, status])
  @@index([uploadedBy])
  @@index([fileName])
}

model LearningFactoryDraft {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @db.Uuid
  sourceDocumentId   String?                    @db.Uuid
  publishedSimulationId String?                  @unique @db.Uuid
  title              String
  description        String                     @db.Text
  assetType          LearningFactoryAssetType
  status             LearningFactoryDraftStatus @default(DRAFT)
  generatedFrom      String
  capabilityMappings Json
  importance         KnowledgeImportance
  confidence         Float
  businessValue      String                     @db.Text
  payload            Json
  publishedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceDocument     Document?                  @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  publishedSimulation Simulation?                @relation("LearningFactoryPublishedSimulation", fields: [publishedSimulationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, assetType, generatedFrom])
  @@index([organizationId, status, updatedAt])
  @@index([sourceDocumentId])
}

model KnowledgeSource {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @db.Uuid
  documentId           String?             @unique @db.Uuid
  sourceType           KnowledgeSourceType
  title                String
  mimeType             String?
  sizeBytes            BigInt?
  status               ProcessingStatus    @default(Uploaded)
  progress             Int                 @default(0)
  extractedText        String?             @db.Text
  pageCount            Int?
  wordCount            Int?
  characterCount       Int?
  estimatedTokens      Int?
  language             String?
  processingDurationMs Int?
  processedAt          DateTime?
  failureReason        String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document             Document?           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  jobs                 ProcessingJob[]
  chunks               KnowledgeChunk[]
  logs                 ProcessingLog[]
  intelligenceSections KnowledgeIntelligenceSection[]

  @@index([organizationId, status])
  @@index([sourceType])
}

model KnowledgeIntelligenceSection {
  id             String              @id @default(uuid()) @db.Uuid
  sourceId       String              @db.Uuid
  sectionNumber  Int
  title          String
  summary        String              @db.Text
  sectionType    KnowledgeSectionType
  confidence     Float
  keywords       String[]
  importance     KnowledgeImportance
  capabilities   String[]
  isAiSuggestion Boolean             @default(true)
  analysisVersion String             @default("heuristic-v0.1")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  source         KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, sectionNumber])
  @@index([sourceId, sectionType])
}

model ProcessingJob {
  id                String           @id @default(uuid()) @db.Uuid
  sourceId          String           @db.Uuid
  status            ProcessingStatus @default(Queued)
  progress          Int              @default(0)
  attempt           Int              @default(0)
  retryCount        Int              @default(0)
  maxAttempts       Int              @default(3)
  queuedAt          DateTime         @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelRequestedAt DateTime?
  lastAttemptAt     DateTime?
  durationMs        Int?
  failureReason     String?
  errorMessage      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  source            KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  logs              ProcessingLog[]

  @@index([status, queuedAt])
  @@index([sourceId, createdAt])
}

model KnowledgeChunk {
  id             String          @id @default(uuid()) @db.Uuid
  sourceId       String          @db.Uuid
  documentId     String?         @db.Uuid
  documentVersion Int            @default(1)
  status          KnowledgeChunkStatus @default(ACTIVE)
  chunkNumber    Int
  sectionTitle    String?
  headingPath     Json?
  pageNumber      Int?
  slideNumber     Int?
  sheetName       String?
  rowStart        Int?
  rowEnd          Int?
  text           String          @db.Text
  characterCount Int
  estimatedTokens Int
  metadata       Json
  contentHash     String?
  createdAt      DateTime        @default(now())
  source         KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document       Document?       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding      KnowledgeChunkEmbedding?

  @@unique([sourceId, documentVersion, chunkNumber])
  @@index([documentId])
  @@index([documentId, documentVersion, status])
  @@index([sourceId, status])
}

model KnowledgeChunkEmbedding {
  id          String   @id @default(uuid()) @db.Uuid
  chunkId     String   @unique @db.Uuid
  provider    String
  model       String
  dimensions  Int
  contentHash String
  embeddedAt  DateTime @default(now())
  embedding   Unsupported("vector")
  chunk       KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([provider, model, dimensions])
}

model ProcessingLog {
  id        String             @id @default(uuid()) @db.Uuid
  sourceId  String             @db.Uuid
  jobId     String?            @db.Uuid
  level     ProcessingLogLevel @default(Info)
  event     String
  message   String
  details   Json?
  createdAt DateTime           @default(now())
  source    KnowledgeSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  job       ProcessingJob?     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
  @@index([jobId, createdAt])
}

model DocumentVersion {
  id          String           @id @default(uuid()) @db.Uuid
  documentId  String           @db.Uuid
  version     Int
  fileName    String
  fileType    DocumentFileType
  mimeType    String
  sizeBytes   BigInt
  storagePath String           @unique
  uploadedBy  String           @db.Uuid
  uploadedAt  DateTime         @default(now())
  notes       String           @default("")
  retrievalStatus DocumentVersionRetrievalStatus @default(ACTIVE)
  processedAt DateTime?
  retrievalReadyAt DateTime?
  failedAt DateTime?
  failureReason String?
  document    Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploader    Profile          @relation("DocumentVersionUploader", fields: [uploadedBy], references: [id])

  @@unique([documentId, version])
  @@index([uploadedBy])
  @@index([documentId, retrievalStatus])
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           UserRole     @default(Learner)
  joinedAt       DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  action         String
  description    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          Profile?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
}
